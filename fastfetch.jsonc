    },
    {
      "type": "command",
      "key": "\udb86\udd9f Aetas Operativa",
      "keyColor": "red",
      "text": "echo $(( ($(date +%s) - $(stat -c %W / 2>/dev/null || stat -c %Y /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "\udb86\uded0 Tempus Vigilandi",
      "keyColor": "red"
    },
    {
      "type": "command",
      "key": "\ueb29 Benedictio",
      "keyColor": "red",
      "text": "updated=$(omarchy-version-pkgs 2>/dev/null || date '+%A, %B %d %Y'); echo \"$updated\""
