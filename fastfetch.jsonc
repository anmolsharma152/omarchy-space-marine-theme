    "break",
    {
      "type": "custom",
      "format": "\u001b[34m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 Spiritus Machinae (OS) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m"
    },
    {
      "type": "command",
      "key": "\ue900 Imperium OS",
      "keyColor": "blue",
      "text": "version=$(omarchy-version 2>/dev/null || echo '4.0') && echo \"Omarchy $version\""
    },
    {
      "type": "command",
      "key": "\u2502 \u251c\udb81\ude2c Legio",
      "keyColor": "blue",
      "text": "omarchy-version-branch 2>/dev/null || echo 'quattro'"
    },
    {
      "type": "command",
      "key": "\u2502 \u251c\udb81\udd2b Canalis",
      "keyColor": "blue",
      "text": "channel=$(omarchy-version-channel 2>/dev/null || echo 'stable'); echo \"$channel\""
    },
    {
      "type": "kernel",
      "key": "\u2502 \u251c\uf013 Nucleus Systematis",
      "keyColor": "blue"
    },
    {
